# Copy to inventory_import.env and edit for the host where SeisComP runs.
# CLI arguments override these values.

# SeisComP installation root. If unset, inventory_import.py tries:
# 1. --seiscomp-root
# 2. SEISCOMP_ROOT
# 3. ~/seiscomp
# 4. ../seiscomp relative to earthquake-hub-commons
SEISCOMP_ROOT=/home/sysop/seiscomp

# Raspberry Shake FDSN Station service endpoint used when --source-file is not
# provided. The importer appends query parameters for network/station/level.
RSHAKE_FDSN_STATION_URL=https://data.raspberryshake.org/fdsnws/station/1/query

# Default RShake request/import settings.
DEFAULT_NETWORK=AM
DEFAULT_LOCATION=00
DEFAULT_STATION_LEVEL=response

# Binding template used for AM Raspberry Shake stations.
DEFAULT_BINDING_TEMPLATE=inventory-bindings/rshake-am-ehz.key

# Run "seiscomp update-config" after "seiscomp update-config inventory".
# Keep true for normal production imports so module-native configs are refreshed.
RUN_FULL_UPDATE_CONFIG=true
