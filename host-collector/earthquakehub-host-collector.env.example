# First WSTunnel loopback port the host collector is allowed to report.
# Keep this exactly aligned with TUNNEL_PORT_RANGE_START.
HOST_COLLECTOR_WSTUNNEL_PORT_RANGE_START=22000
# Last WSTunnel loopback port the host collector is allowed to report. The
# inclusive range may contain at most 4096 ports and must match *_RANGE_END.
HOST_COLLECTOR_WSTUNNEL_PORT_RANGE_END=22999
# Absolute path of the group-protected Unix socket. No TCP listener is created.
HOST_COLLECTOR_SOCKET_PATH=/run/earthquakehub-host-collector/collector.sock
