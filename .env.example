# EarthquakeHub deployment environment template.
# Copy this file to .env, keep .env mode 0600, and replace every placeholder.
# Never commit .env, private keys, passwords, bearer tokens, or generated PKI.
# Values shown here are defaults/examples, not a production secret set.
# The admin-only catalog and valid ranges are documented in:
# docs/admin-backend/environment-reference.md

# ---------- PUBLIC SITE ----------
# Canonical hostname without scheme or path. Used by Compose fallback URLs.
PUBLIC_SITE_HOST=<ehub-domain>
# Canonical browser origin with scheme and no trailing slash.
PUBLIC_SITE_ORIGIN=https://<ehub-domain>
# Comma-separated hostnames accepted by the public React frontend.
REACT_APP_PROD_HOSTS=<ehub-domain>

# ---------- MONGODB ----------
# docker builds mongodb://MONGO_HOST:MONGO_PORT/MONGO_NAME; cloud uses MONGO_HOST
# as the managed cluster address. Production Compose normally uses docker.
MONGO_CONNX_TYPE=docker
MONGO_HOST=mongodb       # use "mongodb-dep-test" for deployment testing
MONGO_PORT=27017
MONGO_NAME=latestEQs

# ---------- ADMIN DATA LIFECYCLE ----------
# Successful telemetry-read audit events; 0 keeps new records indefinitely.
ADMIN_AUDIT_TELEMETRY_RETENTION_DAYS=90
# Authentication, mutation, failure, export, and other administrative audits.
ADMIN_AUDIT_ADMINISTRATIVE_RETENTION_DAYS=730
# Resolved incident records; active incidents never expire.
ADMIN_INCIDENT_RESOLVED_RETENTION_DAYS=730
# Append-only incident lifecycle events. Keep this at least as long as above.
ADMIN_INCIDENT_EVENT_RETENTION_DAYS=730
# Append-only station activity and WSTunnel registry transitions.
ADMIN_STATION_HISTORY_RETENTION_DAYS=365
# Seconds between retained Ringserver packet-freshness samples (60-86400).
ADMIN_STATION_TELEMETRY_SAMPLE_INTERVAL_SECONDS=900
# Days to retain packet-freshness samples (1-3650).
ADMIN_STATION_TELEMETRY_RETENTION_DAYS=90
# Maximum attempts across an original background job and its safe retries (1-10).
ADMIN_JOB_MAX_ATTEMPTS=3
# Days to retain completed/failed background-job records; 0 means indefinite.
ADMIN_JOB_RETENTION_DAYS=180
# Per-attempt execution timeout in milliseconds (60000-86400000).
ADMIN_JOB_TIMEOUT_MS=3600000

# ---------- ADMIN OVERVIEW READ MODEL ----------
# Maximum time allowed for each Overview source before it is marked unavailable.
ADMIN_OVERVIEW_SOURCE_TIMEOUT_MS=2500
# Short server-side cache lifetime for the aggregated Overview snapshot.
ADMIN_OVERVIEW_CACHE_TTL_MS=5000

# ---------- ADMIN AUTHORIZATION AND FEATURE GATES ----------
# These switches are enforced by the hub backend. false disables the route as
# well as its UI capability. They do not replace role checks or audit policy.
# Permit approval/rejection of pending barangay accounts.
ADMIN_ACCOUNT_APPROVAL_ENABLED=true
# Permit account activation and deactivation.
ADMIN_ACCOUNT_LIFECYCLE_ENABLED=true
# Permit revocation of a user's active web sessions.
ADMIN_ACCOUNT_SESSION_REVOCATION_ENABLED=true
# Permit assignment of admin-viewer/operator/super-admin tiers.
ADMIN_ACCOUNT_ROLE_MANAGEMENT_ENABLED=true
# Permit acknowledge/investigate/assign/note/resolve incident transitions.
ADMIN_INCIDENT_MANAGEMENT_ENABLED=true
# Maximum age of the administrator's authentication for guarded actions.
ADMIN_RECENT_AUTH_MAX_AGE_SECONDS=900
# Permit community-report moderation and persistent case transitions.
ADMIN_REPORT_MODERATION_ENABLED=true
# Permit permanent community-report deletion with confirmation and audit.
ADMIN_REPORT_DELETION_ENABLED=true
# Permit generated/custom event-summary editing.
ADMIN_EVENT_SUMMARY_ENABLED=true
# Permit summary submit/approve/revert publication workflow.
ADMIN_EVENT_SUMMARY_REVIEW_ENABLED=true
# Approved custom summaries are the public publication boundary. Set this to
# true only during the staged migration from older clients, then return it to
# false after legacy summaries have been reviewed.
EVENT_SUMMARY_ALLOW_UNAPPROVED_COMPAT=false
# Permit bounded earthquake-event enrichment background jobs.
ADMIN_EVENT_ENRICHMENT_ENABLED=true
# Permit bounded recording-availability refresh jobs.
ADMIN_EVENT_RECORDING_REFRESH_ENABLED=true
# Permit approved remote Ringserver configuration actions on sender devices.
ADMIN_DEVICE_REMOTE_ACTIONS_ENABLED=true
# Permit WSTunnel registry revocation.
ADMIN_TUNNEL_REVOCATION_ENABLED=true

# Granular reverse-geolocation
GEOSERVE_HOST=geoserve-ws
GEOSERVE_PORT=80

# Earthquake event online-station and catalog enrichment jobs
FDSNWS_DATASELECT_URL=https://earthquake.up.edu.ph/fdsnws/dataselect/1/query
FDSNWS_NETWORK=AM
FDSNWS_LOCATION=00
FDSNWS_CHANNEL=EHZ
FDSNWS_WINDOW_SECONDS=30
ONLINE_STATION_REFINEMENT_DELAY_MS=0
# Recording availability refinement:
# - During grace period, candidate stations remain visible while FDSN data catches up.
# - Retry delay / max attempts control follow-up checks before events are marked unavailable.
RECORDING_AVAILABILITY_GRACE_PERIOD_MS=1800000
RECORDING_AVAILABILITY_RETRY_DELAY_MS=300000
RECORDING_AVAILABILITY_MAX_ATTEMPTS=4
# Primary event provenance written on live SeisComP ingest.
EVENT_SOURCE_CATALOG=upri-current
EVENT_SOURCE_SERVER=earthquake.up.edu.ph
EVENT_SOURCE_SEISCOMP_VERSION=
TZ=Asia/Manila
ENRICHMENT_CRON=0 2 * * *
ENRICHMENT_MIN_AGE_HOURS=12
MAX_ENRICHMENT_ATTEMPTS=3
ENRICHMENT_BATCH_SIZE=25
ENRICHMENT_RUN_ON_STARTUP=false
ENRICHMENT_STARTUP_DELAY_MS=30000
ENRICHMENT_LOCK_TTL_MS=3600000
USGS_REQUEST_TIMEOUT_MS=15000
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# production host domain (and for deployment testing)
W3_CLIENT_PROD_HOST=rs.local:3000 # rshake client domain name
CLIENT_PROD_HOST=localhost        # web app domain name
BACKEND_PROD_HOST=localhost/api
BACKEND_PROD_PORT=5000

# development host domains (used when backend runs with NODE_ENV != production)
W3_CLIENT_DEV_HOST=localhost
CLIENT_DEV_HOST=localhost
CLIENT_DEV_PORT=3000
BACKEND_DEV_HOST=backend
BACKEND_DEV_PORT=5000

#ringserver host
RINGSERVER_HOST=host.docker.internal
RINGSERVER_PORT=16000

#jsonwebtoken keys
# Generate a strong secret via:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# IMPORTANT: Do not deploy with placeholder values (e.g., "some_secret_key_*").
#
# Web app session cookies (HTTP-only)
# - ACCESS_TOKEN_PRIVATE_KEY_WEB: signs/verifies web access JWTs stored in the `accessToken` cookie (citizen/brgy browser sessions).
# - REFRESH_TOKEN_PRIVATE_KEY_WEB: signs/verifies web refresh JWTs stored in the `refreshToken` cookie (silent session refresh).
# - JWT_WEB_EXPIRY: lifetime for web access JWTs (also drives cookie max-age).
# - REFRESH_TOKEN_WEB_EXPIRY: lifetime for web refresh JWTs (also drives cookie max-age).
ACCESS_TOKEN_PRIVATE_KEY_WEB=some_secret_key_for_web
REFRESH_TOKEN_PRIVATE_KEY_WEB=some_refresh_secret_key_for_web
JWT_WEB_EXPIRY='12h'
REFRESH_TOKEN_WEB_EXPIRY='30 days'

# Account identifiers & username policy
# Sign-in accepts username or contact email; adjust these only if all services share the same rules.
USERNAME_MIN_LENGTH=3
USERNAME_MAX_LENGTH=32
USERNAME_ALLOWED_PATTERN=^[a-zA-Z0-9._-]+$
# Community report moderation + rate limiting:
# - COMMENTS_DEFAULT_STATUS=approved preserves legacy behavior.
# - Set to pending when admin moderation should gate visibility.
COMMENTS_DEFAULT_STATUS=approved
REPORT_POST_RATE_LIMIT_WINDOW_MS=900000
REPORT_POST_RATE_LIMIT_MAX=10
# Window for admin login throttling, in milliseconds.
ADMIN_AUTH_RATE_LIMIT_WINDOW_MS=900000
# Maximum admin login attempts per source address during the window.
ADMIN_AUTH_RATE_LIMIT_IP_MAX=30
# Maximum admin login attempts per normalized username/email during the window.
ADMIN_AUTH_RATE_LIMIT_IDENTIFIER_MAX=5

# ---------- ADMIN RELEASE IMAGES ----------
# Use one reviewed immutable SemVer tag for coordinated releases. `latest` is
# retained only as a backwards-compatible default and is not rollback-safe.
ADMIN_FRONTEND_IMAGE_TAG=latest
ADMIN_BACKEND_IMAGE_TAG=latest
EHUB_BACKEND_IMAGE_TAG=latest
EHUB_FRONTEND_IMAGE_TAG=latest

# ---------- PRIVATE ADMIN TELEMETRY ----------
# Internal adapter base URL. Empty disables private host telemetry.
ADMIN_HOST_TELEMETRY_URL=
# Independent bearer token shared only by ehub-backend and admin-backend.
ADMIN_HOST_TELEMETRY_TOKEN=
# Hub-backend request timeout for one adapter resource, in milliseconds.
ADMIN_HOST_TELEMETRY_TIMEOUT_MS=2500
# Age after which returned operational evidence is shown as stale.
ADMIN_TELEMETRY_STALE_AFTER_MS=60000
# Require HTTPS, trusted CA, and client certificate paths in ehub-backend.
ADMIN_HOST_TELEMETRY_TLS_REQUIRED=false
# Host directories generated by generate-admin-telemetry-pki.sh.
ADMIN_TELEMETRY_SERVER_PKI_DIR=./secrets/admin-telemetry/server
ADMIN_TELEMETRY_CLIENT_PKI_DIR=./secrets/admin-telemetry/client
# Timeout applied by admin-backend to each fixed downstream check.
ADMIN_TELEMETRY_CHECK_TIMEOUT_MS=1500
# Fixed health/readiness endpoints; browser input cannot replace these URLs.
ADMIN_TELEMETRY_DEPLOYMENT_CHECK_URL=http://ehub-backend:5000/health/ready
ADMIN_TELEMETRY_SEISCOMP_CHECK_URL=http://host.docker.internal:8080/fdsnws/dataselect/1/version
# Mount empty marker directories located on the target filesystems. Do not mount
# host root or the full waveform archive merely to obtain statfs capacity data.
# bootstrap-admin-host.sh creates the local deployment marker automatically and
# can create the archive marker only with an explicitly verified separate mount.
ADMIN_TELEMETRY_ARCHIVE_HOST_PATH=./archive-telemetry-sample
ADMIN_TELEMETRY_SERVER_FILESYSTEM_HOST_PATH=./archive-telemetry-sample
# Safe labels displayed beside filesystem evidence; no host path is returned.
ADMIN_TELEMETRY_ARCHIVE_SOURCE_LABEL=Configured archive filesystem
ADMIN_SERVER_FILESYSTEM_LABEL=Deployment filesystem
# Keep deployment-container until actual-server comparison proves the reported
# CPU/memory/filesystem values represent the VM accurately.
ADMIN_HOST_METRICS_SCOPE=deployment-container
ADMIN_HOST_METRICS_SOURCE_LABEL=EarthquakeHub admin telemetry container
# CPU sampling duration used by the adapter (50-1000 milliseconds).
ADMIN_HOST_CPU_SAMPLE_MS=150
# Optional host-native collector. Leave the socket path empty until its dedicated
# systemd unit and shared group are installed. It exposes only point-in-time
# loopback listener evidence for the fixed WSTunnel range over a Unix socket.
ADMIN_HOST_COLLECTOR_SOCKET_PATH=
# Host directory containing only the group-protected collector Unix socket.
ADMIN_HOST_COLLECTOR_SOCKET_DIR=./runtime/admin-host-collector
# Adapter-to-collector timeout; implementation caps this at 2000 ms.
ADMIN_HOST_COLLECTOR_TIMEOUT_MS=1000
# Set this to: getent group ehub-admin-telemetry | cut -d: -f3
ADMIN_HOST_COLLECTOR_GID=65534
# Number of trusted reverse-proxy hops. Set to the actual deployment topology.
TRUST_PROXY=1
# Report image upload storage (required in production backend)
# UPLOAD_DIR is the container path used by the backend.
# UPLOAD_HOST_DIR is the host path mounted into that container path for persistence.
# Keep it outside disposable container filesystems, include it in backups, and restore
# its contents before connecting an existing database to a replacement deployment host.
# Public URLs emitted by the API will be prefixed with UPLOAD_PUBLIC_PATH.
UPLOAD_DIR=/app/public/uploads
UPLOAD_HOST_DIR=./backend-uploads
UPLOAD_PUBLIC_PATH=/uploads

# Device / non-cookie tokens (ringserver, sensors, sender devices, barangays)
# - ACCESS_TOKEN_PRIVATE_KEY_DEVICE: signs/verifies sensor/sender access JWTs (Authorization: Bearer <token>).
# - ACCESS_TOKEN_PRIVATE_KEY_BRGY: signs/verifies barangay access JWTs (RingServer bearer, etc.).
# - REFRESH_TOKEN_PRIVATE_KEY: signs/verifies sensor/sender refresh JWTs.
# - REFRESH_TOKEN_PRIVATE_KEY_BRGY: signs/verifies barangay refresh JWTs.
# - REFRESH_TOKEN_EXPIRY: default lifetime for device refresh JWTs (if `REFRESH_TOKEN_DEVICE_EXPIRY` is unset).
# - REFRESH_TOKEN_BRGY_EXPIRY: optional barangay refresh JWT lifetime (defaults to 365d).
# - JWT_DEVICE_EXPIRY / JWT_BRGY_EXPIRY: optional access token lifetimes (defaults: device 12h, brgy 365d).
# - REFRESH_TOKEN_DEVICE_EXPIRY: optional device refresh token lifetime (defaults to REFRESH_TOKEN_EXPIRY).
ACCESS_TOKEN_PRIVATE_KEY_DEVICE=some_secret_key_for_devices
ACCESS_TOKEN_PRIVATE_KEY_BRGY=some_secret_key_for_brgys
REFRESH_TOKEN_PRIVATE_KEY=some_refresh_secret_key_for_devices
REFRESH_TOKEN_PRIVATE_KEY_BRGY=some_refresh_secret_key_for_brgys
REFRESH_TOKEN_EXPIRY='90 days'
REFRESH_TOKEN_DEVICE_EXPIRY='90 days'
REFRESH_TOKEN_BRGY_EXPIRY='365d'
JWT_DEVICE_EXPIRY='30d'
JWT_BRGY_EXPIRY='365d'
# During rollout, set ACCESS_TOKEN_PRIVATE_KEY_DEVICE equal to your legacy ACCESS_TOKEN_PRIVATE_KEY to avoid invalidating existing sender tokens. After rotation to a new device key, existing sender tokens will fail verification and devices must re-authenticate to obtain fresh tokens.

# Legacy fallbacks (used only if the scoped keys above are not set)
# - ACCESS_TOKEN_PRIVATE_KEY: legacy single-secret fallback for access tokens. Rotating it invalidates any legacy-signed tokens.
# - JWT_EXPIRY: legacy access-token lifetime fallback (used for device tokens if `JWT_DEVICE_EXPIRY` is unset).
ACCESS_TOKEN_PRIVATE_KEY=legacy_fallback_secret
JWT_EXPIRY='30d'

# Password reset tokens (single use)
# - PASSWORD_RESET_TOKEN_KEY: signs/verifies password reset JWTs embedded in reset links. Rotating invalidates outstanding reset links.
# - PASSWORD_RESET_TOKEN_EXPIRY: lifetime of reset links (shorter is safer).
PASSWORD_RESET_TOKEN_KEY=some_password_reset_secret
PASSWORD_RESET_TOKEN_EXPIRY='30m'

# Email sender (Nodemailer SMTP; defaults work with MailHog/Mailpit on localhost:1025)
EMAIL_TRANSPORT=smtp
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="UPRI Earthquake Hub <no-reply@up.edu.ph>"
# Optional branding logo for HTML emails:
# - EMAIL_LOGO_URL: publicly reachable logo URL (recommended for deployed containers).
# - EMAIL_LOGO_PATH: local file path fallback if URL is not set.
# - EMAIL_LOGO_PUBLIC_FILE: filename inside frontend public dir (e.g. badge-92x92.png).
# - EMAIL_FRONTEND_PUBLIC_DIR: optional override for frontend public directory root.
# EMAIL_LOGO_URL=https://example.org/assets/upri-logo.png
# EMAIL_LOGO_PATH=
# EMAIL_LOGO_PUBLIC_FILE=badge-92x92.png
# EMAIL_FRONTEND_PUBLIC_DIR=
EMAIL_LOGO_URL=
EMAIL_LOGO_PATH=
EMAIL_LOGO_PUBLIC_FILE=
EMAIL_FRONTEND_PUBLIC_DIR=
# Sender-alert email routing:
# - ALERT_EMAIL_ADMIN_TO: admin monitor recipients (comma/semicolon separated)
# - ALERT_EMAIL_THREAD_*: force admin alerts into one thread
# - EMAIL_ALERT_ADMIN_TO: optional legacy alias fallback
# - RSHAKE_ALERT_SHARED_SECRET: optional shared secret required by
#   /messaging/restricted/rshake-alert (`X-RShake-Alert-Secret` header).
ALERT_EMAIL_ADMIN_TO=earthquake@science.upd.edu.ph
ALERT_EMAIL_THREAD_KEY=rshake-alerts
ALERT_EMAIL_THREAD_DOMAIN=earthquake-hub.local
EMAIL_ALERT_ADMIN_TO=
RSHAKE_ALERT_SHARED_SECRET=replace_with_long_random_secret
RSHAKE_ALERT_DEVICE_SECRET_BYTES=32
# Production SMTP port + TLS mode:
# - EMAIL_PORT=587 with EMAIL_SECURE=false uses STARTTLS (connect plain, then upgrade to TLS). Common for Gmail and many providers.
# - EMAIL_PORT=465 with EMAIL_SECURE=true uses implicit TLS/SMTPS (TLS from the first byte).
# Match your provider’s documentation; using the wrong pairing often causes TLS handshake/auth failures.

# webpush VAPID keys for notification
# generate keys via (run after npm install in ehub-backend): ./node_modules/.bin/web-push generate-vapid-keys
WEB_PUSH_CONTACT=mailto:contact@my-site.com
PUBLIC_VAPID_KEY=paste_public_key_here
PRIVATE_VAPID_KEY=paste_private_key_here
# notification subscription cleanup controls (ehub-backend)
NOTIF_CLEANUP_ENABLED=true
NOTIF_CLEANUP_INTERVAL_MIN=60
NOTIF_STALE_DAYS=90
NOTIF_FAILURE_THRESHOLD=3
NOTIF_INVALID_TTL_DAYS=7

# Tunnel service (bastion): core enrollment + registry
TUNNEL_REGISTER_SCRIPT=/opt/upri/bastion/register-device.sh
TUNNEL_REVOKE_SCRIPT=/opt/upri/bastion/revoke-device.sh
TUNNEL_RESOLVE_SCRIPT=/opt/upri/bastion/resolve-device.sh
TUNNEL_SCRIPT_TIMEOUT_MS=15000
TUNNEL_REGISTRY_FILE=/etc/upri/rshake-tunnels/devices.csv
TUNNEL_BASTION_HOST=ops.example.org
# SSH port emitted as REMOTE_TUNNEL_BASTION_PORT during enrollment metadata.
# This does not control wstunnel transport; use TUNNEL_WSS_URL for that.
TUNNEL_BASTION_PORT=22
TUNNEL_PORT_RANGE_START=22000
TUNNEL_PORT_RANGE_END=22999

# Tunnel service (bastion): websocket transport
# Public websocket endpoint returned to sender enrollment clients.
# Keep host/root only; request path is controlled by TUNNEL_WSS_PATH_PREFIX.
TUNNEL_WSS_URL=wss://<DOMAIN>
# Shared websocket upgrade path prefix enforced by nginx.
# Use a long random suffix in production (example: api/ws-tunnel/2f7a4f...).
# To print a suggested suffix and matching nginx/restriction guidance:
# bastion-tunnel PRINT_WSTUNNEL_CONFIG
TUNNEL_WSS_PATH_PREFIX=api/ws-tunnel/change-me
# wstunnel server image tag used by earthquake-hub-commons/docker-compose.yml.
# Use upstream tag format with leading "v" (example: v10.5.2).
WSTUNNEL_SERVER_VERSION=v10.5.2

# Tunnel service (bastion): SSH execution for register/revoke scripts
# Tunnel script execution mode:
# - local: execute scripts directly in backend runtime
# - ssh: execute scripts remotely on bastion host over SSH (recommended for containerized backend)
TUNNEL_SCRIPT_EXEC_MODE=ssh
TUNNEL_SCRIPT_SSH_HOST=host.docker.internal
TUNNEL_SCRIPT_SSH_PORT=22
TUNNEL_SCRIPT_SSH_USER=tunnel-admin
TUNNEL_SCRIPT_SSH_KEY_PATH=/opt/upri/bastion/ssh/tunnel-admin_id_ed25519
TUNNEL_SCRIPT_SSH_KNOWN_HOSTS_PATH=/opt/upri/bastion/ssh/known_hosts
TUNNEL_SCRIPT_SSH_STRICT_HOST_KEY=true
# Remote command prefix before register/revoke script path.
# Example: use "sudo -n" for passwordless sudo wrapper on bastion host.
TUNNEL_SCRIPT_SSH_REMOTE_PREFIX=sudo -n

# Remote action: relay/direct execution settings
# Remote action execution mode:
# - auto  : use relay mode when TUNNEL_SCRIPT_EXEC_MODE=ssh, else direct
# - relay : backend executes remote action through bastion host over script SSH
# - direct: backend SSHes directly to remote_port
TUNNEL_REMOTE_ACTION_EXEC_MODE=auto
# In relay mode, sender endpoint host on bastion host (usually loopback).
TUNNEL_REMOTE_ACTION_TARGET_SSH_HOST=127.0.0.1
# Optional command prefix for relay mode remote actions (normally empty).
# Keep empty unless you explicitly need a wrapper command for the inner sender SSH hop.
TUNNEL_REMOTE_ACTION_RELAY_SSH_REMOTE_PREFIX=
# Direct-mode SSH settings (also used as inner SSH settings in relay mode).
# For relay mode this host value is ignored; use TUNNEL_REMOTE_ACTION_TARGET_SSH_HOST.
TUNNEL_REMOTE_ACTION_SSH_HOST=host.docker.internal
TUNNEL_REMOTE_ACTION_SSH_USER=myshake
TUNNEL_REMOTE_ACTION_SSH_KEY_PATH=/opt/upri/bastion/ssh/operator-remote-actions_id_ed25519
TUNNEL_REMOTE_ACTION_SSH_KNOWN_HOSTS_PATH=/opt/upri/bastion/ssh/known_hosts
TUNNEL_REMOTE_ACTION_SSH_STRICT_HOST_KEY=false
TUNNEL_REMOTE_ACTION_TIMEOUT_MS=20000

# Optional enrollment fallbacks (used only when register-device.sh does not emit keys)
# Fallback for REMOTE_TUNNEL_OPERATOR_PUBLIC_KEY.
TUNNEL_REMOTE_ACTIONS_OPERATOR_PUBLIC_KEY=
# Optional fallback public key returned by backend enrollment when register-device.sh
# does not emit REMOTE_TUNNEL_OPERATOR_SSH_PUBLIC_KEY.
TUNNEL_OPERATOR_SSH_PUBLIC_KEY=
# Known_hosts pin line returned to sender auto-enrollment.
# Set this on new servers so devices can verify the bastion SSH host key.
# Preferred on-server generation:
# bastion-tunnel PRINT_HOST_KEY --public-bastion-host ops.example.org
# Remote fallback: ssh-keyscan -t ed25519 ops.example.org
# Example value: TUNNEL_BASTION_HOST_KEY=ops.example.org ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...
TUNNEL_BASTION_HOST_KEY=

# ---------- FOR EARTHQUAKE HUB FRONTEND ----------
REACT_APP_PUBLIC_VAPID_KEY=paste_public_key_here
REACT_APP_FDSNWS=https://<ehub-addr>/fdsnws
REACT_APP_RS_FDSNWS=https://fdsnws.raspberryshakedata.com/fdsnws
REACT_APP_BACKEND=https://<ehub-addr>/api
REACT_APP_BACKEND_DEV=http://172.22.0.3:5000
REACT_APP_RINGSERVER_WS=wss://<ehub-addr>/ringserver/datalink
REACT_APP_RINGSERVER_WS_DEV=ws://127.0.0.1:16000/datalink
REACT_APP_REMOTE_ACTION_REQUIRE_TUNNEL=true
REACT_APP_DEFAULT_RINGSERVER_USERNAME=upri
# Optional local/demo waveform playback controls.
REACT_APP_SEIS_DEMO=
REACT_APP_SEIS_DEMO_URL=
REACT_APP_VERSION=

# Google Analytics (GA4)
# Production web stream Measurement ID
REACT_APP_GA_MEASUREMENT_ID=
# Dev/staging web stream Measurement ID (optional)
REACT_APP_GA_MEASUREMENT_ID_DEV=

# The following are NOT used in docker-compose.dep-test (testing),
# only in actual deployment. Make sure to change these values
# ---------- FOR GEOSERVE DB ----------
DATALOAD_DIR=/tmp/dataload
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=change_me_admin_password
DB_LOAD_TYPE=incremental
DB_NAME=earthquake
DB_USER=web
DB_PASS=change_me_db_password
DB_SCHEMA=geoserve
DB_ADMIN_DSN=pgsql:dbname=earthquake
PGDATA=/var/lib/postgresqsl/data/pgdata
POSTGRES_PASSWORD=change_me_admin_password

# ---------- FOR GEOSERVE WS ----------
# Reuses DB_USER, DB_PASS, and DB_SCHEMA from the Geoserve DB section above.
DB_DSN=pgsql:host=geoserve-db;port=5432;dbname=earthquake
